# ===================================================
# AGRIQUENE ENVIRONMENT CONFIGURATION
# Smart Procurement Queue & ETA System (SIH 2026)
# ===================================================

# Server Configuration
PROJECT_NAME="AGRIQUENE - Smart Procurement Queue & ETA System"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Secret Key for JWT & Sessions (Replace with secure 64-char key in production)
SECRET_KEY="agriquene_sih2026_super_secure_jwt_secret_key_gov_portal"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL="sqlite:///./agriquene.db"
# DATABASE_URL="postgresql://agriquene_user:password@localhost:5432/agriquene_db"

# Mock OTP Mode (Set to true to accept 123456 as default OTP)
MOCK_OTP_MODE="true"
DEFAULT_DEV_OTP="123456"

# SMS Gateway Integration (Fast2SMS, Twilio, MSG91 or mock)
SMS_GATEWAY_PROVIDER="mock"
SMS_API_KEY="your_sms_gateway_api_key_here"
SMS_SENDER_ID="AGRQNE"

# Firebase Cloud Messaging / Push Notifications (Optional)
FIREBASE_CONFIG='{"apiKey": "AIzaSy...", "authDomain": "agriquene.firebaseapp.com", "projectId": "agriquene-gov"}'

# Email Notification Gateway
EMAIL_API_KEY="your_email_smtp_or_sendgrid_key"
EMAIL_FROM="notifications@agriquene.gov.in"

# DBT / PFMS Payment Gateway Integration (Mock or Sandbox)
PAYMENT_GATEWAY_PROVIDER="mock_pfms_dbt"
PAYMENT_API_KEY="your_payment_gateway_api_key"

# Maps & Location API (OpenStreetMap, Mapbox, or Google Maps)
MAPS_API_KEY="your_maps_api_key_here"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"
